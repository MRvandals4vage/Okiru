    instruction: "Extend index.css style sheets with Google Web Fonts, theme colors and keyframes for scanlines and glow styles"
    replacement_infos {
      original_chunk {
        target_content: "@import \"tailwindcss\";"
        replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --color-on-background: #e5e2e1;\n  --color-on-tertiary-container: #0b5b00;\n  --color-tertiary-fixed: #79ff5b;\n  --color-tertiary: #37fe11;\n  --color-outline: #859399;\n  --color-secondary: #ebb2ff;\n  --color-on-secondary-fixed: #320047;\n  --color-secondary-fixed: #f8d8ff;\n  --color-background: #0A0A0A;\n  --color-primary: #a4e6ff;\n  --color-on-surface-variant: #bbc9cf;\n  --color-tertiary-fixed-dim: #2ae500;\n  --color-primary-fixed-dim: #4cd6ff;\n  --color-surface-bright: #3a3939;\n  --color-surface-container-highest: #353534;\n  --color-surface-container-low: #1c1b1b;\n  --color-primary-fixed: #b7eaff;\n  --color-on-tertiary-fixed-variant: #095300;\n  --color-on-error: #690005;\n  --color-on-secondary-container: #480064;\n  --color-on-secondary: #520071;\n  --color-surface-container-high: #2a2a2a;\n  --color-on-primary: #003543;\n  --color-outline-variant: #3c494e;\n  --color-surface-dim: #131313;\n  --color-inverse-primary: #00677f;\n  --color-surface-variant: #353534;\n  --color-on-tertiary: #053900;\n  --color-surface-tint: #4cd6ff;\n  --color-on-secondary-fixed-variant: #74009f;\n  --color-on-primary-fixed-variant: #004e60;\n  --color-primary-container: #00d1ff;\n  --color-surface-container: #201f1f;\n  --color-inverse-surface: #e5e2e1;\n  --color-on-primary-container: #00566a;\n  --color-surface: #131313;\n  --color-on-surface: #e5e2e1;\n  --color-on-primary-fixed: #001f28;\n  --color-secondary-container: #ce5dff;\n  --color-secondary-fixed-dim: #ebb2ff;\n  --color-error: #ffb4ab;\n  --color-error-container: #93000a;\n  --color-inverse-on-surface: #313030;\n  --color-surface-container-lowest: #0e0e0e;\n  --color-tertiary-container: #28de00;\n  --color-on-error-container: #ffdad6;\n  --color-on-tertiary-fixed: #022100;\n\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n  --font-display: \"Sora\", sans-serif;\n}\n\n@layer utilities {\n  .glass-panel {\n    background: rgba(20, 20, 20, 0.7);\n    backdrop-filter: blur(25px);\n    border: 1px solid rgba(164, 230, 255, 0.1);\n    position: relative;\n  }\n\n  /* Shimmer effect for progress markers */\n  .shimmer-bar {\n    position: relative;\n    overflow: hidden;\n  }\n\n  .shimmer-bar::after {\n    content: \'\';\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 50%;\n    height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);\n    animation: shimmer 2.5s infinite;\n  }\n\n  @keyframes shimmer {\n    100% { left: 200%; }\n  }\n\n  /* Scanline rolling down HUD elements */\n  .scanline {\n    width: 100%;\n    height: 100px;\n    background: linear-gradient(0deg, rgba(164, 230, 255, 0.04) 0%, transparent 100%);\n    position: absolute;\n    bottom: 100%;\n    animation: scan-anim 6s linear infinite;\n    pointer-events: none;\n    z-index: 10;\n  }\n\n  @keyframes scan-anim {\n    0% { bottom: 100%; }\n    100% { bottom: -100px; }\n  }\n\n  /* Corner chamfers and sci-fi glowing borders */\n  .hud-border {\n    position: relative;\n    border: 1px solid rgba(164, 230, 255, 0.25);\n    background: rgba(14, 14, 14, 0.75);\n    backdrop-filter: blur(20px);\n  }\n\n  .hud-border::before {\n    content: \'\';\n    position: absolute;\n    top: -1px;\n    left: -1px;\n    width: 16px;\n    height: 16px;\n    border-top: 2px solid #a4e6ff;\n    border-left: 2px solid #a4e6ff;\n  }\n\n  .hud-border::after {\n    content: \'\';\n    position: absolute;\n    bottom: -1px;\n    right: -1px;\n    width: 16px;\n    height: 16px;\n    border-bottom: 2px solid #a4e6ff;\n    border-right: 2px solid #a4e6ff;\n  }\n\n  .neon-glow-primary {\n    box-shadow: 0 0 20px rgba(164, 230, 255, 0.15);\n  }\n\n  .neon-glow-purple {\n    box-shadow: 0 0 20px rgba(235, 178, 255, 0.15);\n  }\n\n  .rank-badge-clip {\n    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);\n  }\n\n  /* Glowing text */\n  .glitch-text-glow {\n    text-shadow: 0 0 10px rgba(164, 230, 255, 0.6), 0 0 2px rgba(164,230,255,0.9);\n  }\n}\n\nbody {\n  background-color: #050505;\n  color: #e5e2e1;\n  font-family: var(--font-sans);\n  min-height: 100vh;\n  margin: 0;\n  overflow-x: hidden;\n}\n\n/* Custom scrollbars for a game-console style */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #0f0f10;\n}\n::-webkit-scrollbar-thumb {\n  background: #2a2a2c;\n  border-radius: 3px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #4ab5e1;\n}\n"
      }
      num_matches: 1
    }
  }
